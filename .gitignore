# Dependencies
/node_modules

# Production
#
# Two entries because the build moved: Docusaurus writes to build/ by default,
# and package.json overrides it to dist/. Only the default was ignored, so the
# rendered site was committed for a while. Both are named now, and neither is
# the published artifact — nothing deploys from this repository's tree.
/build
/dist

# Generated files
.docusaurus
.cache-loader

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OpenExec local state
#
# A per-checkout SQLite database, its logs, checkpoints and artifacts: what this
# machine did in this repository, not what the repository is. Ignored as a
# directory rather than by extension, because the tool adds new state files
# without asking. Anything in here that is genuinely source — a committed
# openexec.yaml, a stories.json — stays tracked: .gitignore does not affect a
# file that is already in the index.
.openexec/
